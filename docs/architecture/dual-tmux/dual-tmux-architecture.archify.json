  "cards": [
    {
      "dot": "cyan",
      "title": "两层会话",
      "items": [
        "DT = op_* + run_* 的 1:1 绑定",
        "DST = DT + 两侧可证明的 Agent session",
        "tmux 保存进程壳，Agent session 保存对话上下文"
      ]
    },
    {
      "dot": "emerald",
      "title": "一致性原则",
      "items": [
        "Trigger 跟随操作者，通过 persist JSON 迁移",
        "远程 Bullet 固定在工作落点，不同步 sqlite",
        "Hub 锁保证同一 tunnel 同时只有一个 Client 操作"
      ]
    },
    {
      "dot": "amber",
      "title": "恢复安全边界",
      "items": [
        "freeze 使用 PID、cwd、启动时间和进程树证明 session 归属",
        "resume 先恢复工作落点，再导入快照和执行原生 resume",
        "健康恢复只响应结构性失败，不把静止 pane 当故障"
      ]
    }
